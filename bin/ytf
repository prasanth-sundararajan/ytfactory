#!/usr/bin/env python3
"""ytf - YT Factory control CLI."""
import argparse, json, os, subprocess, sys, datetime

BASE = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
CONFIG = os.path.join(BASE, "config", "agents.json")
STATE = os.path.join(BASE, "data", "state.json")

STYLE = {
    "pending": ("90", "o", "PENDING"),
    "ready":   ("36", "o", "READY"),
    "running": ("34", ">", "RUNNING"),
    "done":    ("32", "*", "DONE"),
    "failed":  ("31", "x", "FAILED"),
    "blocked": ("35", "!", "BLOCKED"),
    "skipped": ("90", "-", "SKIPPED"),
}

def paint(text, code, on):
    return "\033[%sm%s\033[0m" % (code, text) if on else text

def load():
    cfg = json.load(open(CONFIG))
    try:
        st = json.load(open(STATE))
    except Exception:
        st = {"agents": {}, "updated": None}
    return cfg, st

def human(ts):
    if not ts:
        return "-"
    try:
        return datetime.datetime.fromisoformat(ts).strftime("%m-%d %H:%M")
    except Exception:
        return str(ts)[:11]

def services(on):
    try:
        out = subprocess.run(
            ["docker", "ps", "--format", "{{.Names}}\t{{.Status}}"],
            capture_output=True, text=True, timeout=8).stdout
    except Exception:
        return []
    rows = []
    for line in out.strip().splitlines():
        parts = line.split("\t")
        if len(parts) == 2 and parts[0].startswith("ytf-"):
            up = "Up" in parts[1]
            rows.append((parts[0], paint("UP", "32", on) if up else paint("DOWN", "31", on)))
    return sorted(rows)

def cmd_status(args):
    cfg, st = load()
    on = args.color == "always" or (args.color == "auto" and sys.stdout.isatty())
    agents = cfg["agents"]

    cols = [("#", 3), ("AGENT", 14), ("ROLE", 30), ("STATUS", 11), ("LAST RUN", 9), ("DUR", 7)]
    sep = "  "
    width = sum(w for _, w in cols) + len(sep) * (len(cols) - 1)

    stamp = datetime.datetime.now().strftime("%Y-%m-%d %H:%M")
    title = "YT FACTORY  .  agent pipeline"
    print(paint(title, "1", on) + stamp.rjust(width - len(title)))
    print("-" * width)
    print(sep.join(h.ljust(w) for h, w in cols))
    print("-" * width)

    counts = {}
    for i, a in enumerate(agents, 1):
        s = st.get("agents", {}).get(a["id"], {})
        status = s.get("status", "pending")
        counts[status] = counts.get(status, 0) + 1
        code, mark, label = STYLE.get(status, ("0", "?", status.upper()))
        badge = paint("%s %s" % (mark, label), code, on)
        dur = s.get("duration_s")
        print(sep.join([
            str(i).ljust(3),
            a["name"][:14].ljust(14),
            a["role"][:30].ljust(30),
            badge + " " * max(0, 11 - len(label) - 2),
            human(s.get("last_run")).ljust(9),
            (("%.1fs" % dur) if dur else "-").ljust(7),
        ]).rstrip())

    print("-" * width)
    order = ["done", "running", "ready", "pending", "blocked", "failed", "skipped"]
    summary = "   ".join("%s %d" % (k, counts[k]) for k in order if counts.get(k))
    print("TOTAL %d   |   %s" % (len(agents), summary))
    print("updated %s" % (st.get("updated") or "never"))

    rows = services(on)
    if rows:
        print()
        print("SERVICES")
        for name, flag in rows:
            print("  %-16s %s" % (name, flag))
    else:
        print()
        print("SERVICES   none deployed yet")

def cmd_json(args):
    cfg, st = load()
    print(json.dumps({"agents": cfg["agents"], "state": st}, indent=2))

def cmd_reset(args):
    cfg = json.load(open(CONFIG))
    now = datetime.datetime.now().isoformat(timespec="seconds")
    st = {"updated": now, "run_id": None,
          "agents": {a["id"]: {"status": "pending", "last_run": None,
                               "duration_s": None, "note": ""} for a in cfg["agents"]}}
    json.dump(st, open(STATE, "w"), indent=2)
    print("state reset: %d agents pending" % len(cfg["agents"]))

def main():
    p = argparse.ArgumentParser(prog="ytf", description="YT Factory control CLI")
    p.add_argument("--color", choices=["auto", "always", "never"], default="auto")
    sub = p.add_subparsers(dest="cmd")
    s = sub.add_parser("status", help="show agent pipeline status")
    s.set_defaults(func=cmd_status)
    j = sub.add_parser("json", help="machine-readable state")
    j.set_defaults(func=cmd_json)
    r = sub.add_parser("reset", help="reset all agents to pending")
    r.set_defaults(func=cmd_reset)
    args = p.parse_args()
    if not getattr(args, "func", None):
        args.color = args.color
        return cmd_status(args)
    return args.func(args)

if __name__ == "__main__":
    main()
